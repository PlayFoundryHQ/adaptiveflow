    <string name="import_guide_title_youtube">How YouTube URL Import Works</string>
    <string name="import_guide_title_pdf">PDF &amp; File Processing</string>
    <string name="import_guide_title_text">Structured Text Parsing</string>
    <string name="import_guide_desc_youtube">Paste a video link plus a Focus/Topic hint describing what it covers. AdaptiveFlow can\'t read the video itself, so the AI builds a deck from the topic you provide. Needs an API key.</string>
    <string name="import_guide_desc_pdf">To study books or PDFs, copy-paste their text chapters or public links. You can also pick a local plain text file directly!</string>
    <string name="import_guide_desc_text">Paste CSV pairs (Front, Back), vocabulary bullet lists, or raw sentences. With an API key the AI extracts translation pairs and adds pronunciation and usage notes where it can; without one, plain \"word: meaning\" lines still import offline.</string>
    <string name="import_helper_title">💡 Study Large PDFs, Books or Long Videos?</string>
    <string name="import_helper_sub_expanded">Tap to collapse external guide</string>
    <string name="import_helper_sub_collapsed">Tap for a copyable expert prompt to let ChatGPT/Claude/Gemini do the heavy lifting!</string>
    <string name="import_expand_collapse_desc">Expand or collapse</string>
    <string name="import_helper_why">Why inline parsers generate fewer cards for large files:</string>
    <string name="import_helper_bullet1">Rate Limits &amp; Token Caps: Multi-page text split into many sequential API requests often triggers protection limits or hits context limits on mobile connections.</string>
    <string name="import_helper_bullet2">Layout Extraction: Scanned, encrypted, columns-based, or diagram-rich PDFs contain text streams that local parsers cannot always extract cleanly.</string>
    <string name="import_helper_bullet3">Video Transcripts: YouTube restriction policies (like geo-fencing, age gates, or disabled captions) block client-side access to full transcripts.</string>
    <string name="import_helper_prompt_label">THE ULTIMATE COPIABLE AGENT PROMPT</string>
