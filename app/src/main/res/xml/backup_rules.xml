<?xml version="1.0" encoding="utf-8"?>
<!-- API keys live in EncryptedSharedPreferences whose master key is device-bound;
     backing up the encrypted blob is useless and breaks restore, so exclude it.
     The Room DB (decks, cards, SRS progress, chat) IS backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="adaptiveflow_secure.xml" />
    <exclude domain="sharedpref" path="adaptiveflow_secure_fallback.xml" />
</full-backup-content>
