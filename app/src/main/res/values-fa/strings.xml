    <string name="import_title">درون‌ریزی با یک لمس</string>
    <string name="import_subtitle">به‌سادگی از متن خام، پیوند YouTube یا فایل PDF دسته بسازید.</string>
    <string name="import_diagnostics_desc">گزارش‌های عیب‌یابی</string>
    <string name="import_mode_text">📝 چسباندن</string>
    <string name="import_mode_youtube">📺 یوتیوب</string>
